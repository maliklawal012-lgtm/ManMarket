APP_ENV=local

DB_HOST=localhost
DB_NAME=manmarket
# 'root' convient pour une premiere installation locale, mais le site en
# fonctionnement n'a besoin que de SELECT/INSERT/UPDATE/DELETE : voir
# DEPLOYMENT.md section 11 pour creer un compte manmarket_app dedie a
# privileges limites (recommande, deja en place sur cet environnement).
DB_USER=root
DB_PASS=

# Optionnel — chemin complet vers mysqldump si absent du PATH systeme (cas
# frequent sous WAMP), utilise par cron/backup_database.php.
# Ex. Windows/WAMP : C:\wamp64\bin\mysql\mysql8.0.31\bin\mysqldump.exe
MYSQLDUMP_BIN=mysqldump

GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_MODE=live
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_MERCHANT_CODE=
GENIUSPAY_WEBHOOK_SECRET=

# Optionnel — laisser vide pour desactiver l'envoi d'emails (mode silencieux, log uniquement).
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@manmarket.ci
SMTP_FROM_NAME=ManMarket
